# One Page Studio — Configuration Reference
# These values are injected directly into index.html (static site, no build step).
# Replace the placeholder strings in the CONFIGURATION block at the top of the <script> tag.

# Supabase project URL (from: Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anonymous/public key (from: Project Settings → API → anon public)
# This key is safe to expose in client-side code — RLS policies protect the data.
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: OpenAI-compatible API key for AI-powered resume text parsing
# If set, expose it as window.__OPS_OPENAI_KEY__ before the main script tag.
# Leave blank to use the built-in heuristic parser instead.
OPENAI_API_KEY=
